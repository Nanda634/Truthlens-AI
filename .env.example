# Database - SQLite is used as the dev fallback. Set a postgresql:// URL for production.
DATABASE_URL=sqlite:///./truthlens.db
# Example for Postgres: postgresql://truthlens:truthlens@localhost:5432/truthlens

JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRE_MINUTES=1440

UPLOAD_DIR=./storage/uploads
TEMP_DIR=./storage/tmp
REPORT_DIR=./storage/reports
MAX_FILE_SIZE=209715200

REDIS_URL=redis://localhost:6379/0

# Pluggable AI model paths. Leave blank to run in forensic-heuristics-only /
# "model unavailable" mode (default, safe for demo/dev use).
MODEL_IMAGE_PATH=
MODEL_VIDEO_PATH=
MODEL_AUDIO_PATH=

RETENTION_DAYS=30
CORS_ORIGINS=http://localhost:5173

# Confidence model weights (must sum to 1.0)
WEIGHT_METADATA=0.10
WEIGHT_FORENSIC=0.25
WEIGHT_ML=0.40
WEIGHT_STRUCTURAL=0.15
WEIGHT_CONSISTENCY=0.10
